# --- AI provider ---
# Which provider the agents call: "anthropic" or "openai"
AI_PROVIDER=anthropic

OPENAI_API_KEY=your_openai_key_here          # required only if AI_PROVIDER=openai
ANTHROPIC_API_KEY=your_anthropic_key_here   # required only if AI_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o

# --- Database ---
DATABASE_URL=sqlite:///dev.db
# For Postgres: postgresql://user:password@localhost:5432/ai_visibility

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me
PORT=5000

# --- External search-data provider (DataForSEO) ---
# Leave USE_MOCK_EXTERNAL_DATA=true to run without DataForSEO credentials;
# every response will be labelled source="simulated" in that mode.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
USE_MOCK_EXTERNAL_DATA=true

# --- Pipeline behaviour ---
MAX_QUERIES_PER_RUN=20
MIN_QUERIES_PER_RUN=10
RATE_LIMIT_PIPELINE=5 per minute
